# 默认所有文本文件用 LF
* text=auto eol=lf

# Shell / Python / Markdown 强制 LF
*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.toml      text eol=lf

# PowerShell 在 Windows 下使用 CRLF
*.ps1       text eol=crlf
*.psm1      text eol=crlf

# 二进制文件
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.tar.gz    binary
